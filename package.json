    "test:qa": "node scripts/qa_probe.mjs",
    "package": "vite build && python scripts/package_web.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
