{
  "name": "bad-omen",
  "version": "0.1.0",
  "private": true,
  "description": "BAD OMEN — a third-person cat chaos physics comedy (Game Jam Europe 2026)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
